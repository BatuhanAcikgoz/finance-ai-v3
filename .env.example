# =============================================================================
# Finance AI V3 - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# =============================================================================
# Application
# =============================================================================
APP_ENV=development
APP_NAME=finance-ai-v3
APP_VERSION=0.1.0

# =============================================================================
# Database - PostgreSQL 16
# =============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finance_ai_v3
POSTGRES_USER=finance_ai_v3
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_MAX_CONNECTIONS=20

# =============================================================================
# Cache + Message Bus - Redis 7
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION
REDIS_DB=0
REDIS_CLUSTER_ENABLED=false

# =============================================================================
# Vector Store - Qdrant 1.10
# =============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=CHANGE_ME_IN_PRODUCTION
QDRANT_COLLECTION_PREFIX=finance_ai_v3

# =============================================================================
# LLM Gateway - LiteLLM
# =============================================================================
LITELLM_HOST=localhost
LITELLM_PORT=4000
LITELLM_MASTER_KEY=CHANGE_ME_IN_PRODUCTION

# Primary provider
LITELLM_PROVIDER=openai  # Options: openai, anthropic, minimax
OPENAI_API_KEY=CHANGE_ME_IN_PRODUCTION
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Fallback providers
ANTHROPIC_API_KEY=CHANGE_ME_IN_PRODUCTION
MINIMAX_API_KEY=CHANGE_ME_IN_PRODUCTION
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# Cost limits
LITELLM_MAX_MONTHLY_COST=500
LITELLM_COST_PER_RECOMMENDATION=0.50

# =============================================================================
# Data Sources - BIST
# =============================================================================
BIST_API_KEY=CHANGE_ME_IN_PRODUCTION
BIST_API_BASE_URL=https://api.bist.com.tr/v1
BIST_WS_URL=wss://ws.bist.com.tr

# =============================================================================
# Data Sources - KAP (Public Disclosure Platform)
# =============================================================================
KAP_API_KEY=CHANGE_ME_IN_PRODUCTION
KAP_API_BASE_URL=https://api.kap.org.tr/v1
KAP_POLL_INTERVAL_SECONDS=300  # 5 minutes

# =============================================================================
# Data Sources - TEFAS (Fund Platform)
# =============================================================================
TEFAS_SCRAPE_BASE_URL=https://www.tefas.com.tr

# =============================================================================
# Data Sources - News
# =============================================================================
# Comma-separated list of RSS feed URLs
NEWS_RSS_FEEDS=https://www.bloomberght.com/rss,https://www.trthaber.com/rss/finans.xml,https://www.aa.com.tr/rss/economy,https://www.reuters.com/rssFeed/topNews?q=Turkey
NEWS_POLL_INTERVAL_SECONDS=120  # 2 minutes

# =============================================================================
# Data Sources - TCMB (Central Bank of the Republic of Turkey)
# =============================================================================
TCMB_EVDS_API_KEY=CHANGE_ME_IN_PRODUCTION
TCMB_EVDS_BASE_URL=https://evds2.tcmb.gov.tr/service

# =============================================================================
# Data Sources - TÜİK (Turkish Statistical Institute)
# =============================================================================
TUIK_API_KEY=CHANGE_ME_IN_PRODUCTION
TUIK_BASE_URL=https://api.tuik.gov.tr

# =============================================================================
# Data Sources - BDDK (Banking Regulation and Supervision Agency)
# =============================================================================
BDDK_BULLETIN_URL=https://www.bddk.org.tr

# =============================================================================
# Email - SendGrid
# =============================================================================
SENDGRID_API_KEY=CHANGE_ME_IN_PRODUCTION
SENDGRID_FROM_EMAIL=noreply@finance-ai-v3.local
SENDGRID_FROM_NAME=Finance AI V3

# SMTP Fallback
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# =============================================================================
# Security
# =============================================================================
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_32_CHARS_MINIMUM
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_32_CHARS_MINIMUM
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours
API_RATE_LIMIT_PER_MINUTE=100
API_RATE_LIMIT_AUTH_PER_MINUTE=10

# =============================================================================
# Observability
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=finance-ai-v3
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# Prometheus
PROMETHEUS_PORT=9090

# Jaeger
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# =============================================================================
# Vault (Production secrets)
# =============================================================================
VAULT_ADDR=https://vault.finance-ai-v3.local:8200
VAULT_AUTH_METHOD=token
VAULT_PATH_PREFIX=secret/finance-ai-v3

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_BACKTEST_ENABLED=true
FEATURE_MULTI_PORTFOLIO_ENABLED=false
FEATURE_REAL_TIME_NEWS_ENABLED=true

# =============================================================================
# Timezone
# =============================================================================
TZ=Europe/Istanbul
