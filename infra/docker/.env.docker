# =============================================================================
# Finance AI V3 - Docker Compose Environment (Dev Only Defaults)
# =============================================================================
# SAFE DEVELOPMENT DEFAULTS — DO NOT USE IN PRODUCTION
# Override by exporting vars in your shell or by mounting a custom .env file.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=finance_ai_v3
POSTGRES_USER=finance_ai_v3
POSTGRES_PASSWORD=dev_only_pw
POSTGRES_MAX_CONNECTIONS=20

# --- Redis ---
REDIS_PASSWORD=dev_only_pw

# --- Qdrant ---
QDRANT_API_KEY=

# --- LiteLLM ---
LITELLM_MASTER_KEY=sk-dev-1234

# --- n8n ---
N8N_PASSWORD=admin_dev
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678

# --- Grafana ---
GRAFANA_PASSWORD=admin

# --- App / Worker shared ---
TZ=Europe/Istanbul

# --- External provider API keys (empty by default; populate locally) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
