{
  "name": "Fundamental Analysis Workflow",
  "nodes": [
    {
      "parameters": {
        "channel": "raw.kap.material",
        "options": {}
      },
      "id": "redis-trigger",
      "name": "Redis Trigger",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1
    },
    {
      "parameters": {
        "url": "http://localhost:8001/api/v1/fundamental/analyze",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "publishing_id",
              "value": "={{ $json.publishing_id }}"
            },
            {
              "name": "title",
              "value": "={{ $json.title }}"
            },
            {
              "name": "category",
              "value": "={{ $json.category }}"
            },
            {
              "name": "tickers",
              "value": "={{ JSON.parse($json.tickers) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-request",
      "name": "Call Fundamental Analysis API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO analysis.fundamental_analyses (analysis_id, ticker, kap_publishing_id, direction, strength, confidence, data_completeness, peer_count, reasoning, analysis_timestamp) VALUES ('{{ $json.analysis_id }}', '{{ $json.ticker }}', '{{ $json.kap_publishing_id }}', '{{ $json.direction }}', {{ $json.strength }}, {{ $json.confidence }}, '{{ $json.data_completeness }}', {{ $json.peer_count }}, '{{ $json.reasoning }}', NOW()) ON CONFLICT (kap_publishing_id) DO UPDATE SET direction = EXCLUDED.direction, strength = EXCLUDED.strength"
      },
      "id": "postgres-insert",
      "name": "PostgreSQL Insert",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1
    },
    {
      "parameters": {
        "channel": "analysis.fundamental.complete",
        "message": "={{ $json }}"
      },
      "id": "redis-publish",
      "name": "Redis Publish Complete",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "confidence-check",
              "leftValue": "={{ $json.confidence }}",
              "rightValue": 0.7,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "options": {}
        },
        "options": {}
      },
      "id": "confidence-filter",
      "name": "High Confidence Filter",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2
    }
  ],
  "connections": {
    "Redis Trigger": {
      "main": [
        [
          {
            "node": "Call Fundamental Analysis API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Fundamental Analysis API": {
      "main": [
        [
          {
            "node": "PostgreSQL Insert",
            "type": "main",
            "index": 0
          },
          {
            "node": "High Confidence Filter",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "PostgreSQL Insert": {
      "main": [
        [
          {
            "node": "Redis Publish Complete",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "High Confidence Filter": {
      "main": [
        [
          {
            "node": "Redis Publish Complete",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
